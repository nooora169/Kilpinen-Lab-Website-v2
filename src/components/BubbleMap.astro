---
const {topics}=Astro.props;
const positions=[[215,235,91],[457,146,90],[486,410,87],[745,292,92],[971,152,80],[951,465,82],[718,547,78],[220,517,79]];
const height=topics.length>8?690+Math.ceil((topics.length-8)/4)*240:690;
const nodes=topics.map((t,i)=>({t,x:positions[i]?.[0]??(210+(i-8)%4*255),y:positions[i]?.[1]??(790+Math.floor((i-8)/4)*240),r:positions[i]?.[2]??82}));
function lines(s){const w=s.split(' ');if(w.length<=2)return w;const mid=Math.ceil(w.length/2);return [w.slice(0,mid).join(' '),w.slice(mid).join(' ')];}
---
<div class="map-shell"><svg class="research-map" viewBox={`0 0 1140 ${height}`} role="group" aria-label="Conceptual research map, not a measured UMAP embedding"><defs><marker id="axis-arrow" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6" fill="none" stroke="currentColor" stroke-width="1.2"/></marker></defs><g class="axes" aria-hidden="true"><path d={`M58 82 V${height-42} H1092`} fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M58 90 V62" marker-end="url(#axis-arrow)" stroke="currentColor" stroke-width="1.5"/><path d={`M1080 ${height-42} H1105`} marker-end="url(#axis-arrow)" stroke="currentColor" stroke-width="1.5"/><text x="1030" y={height-10}>UMAP 1</text><text transform={`translate(25 ${height/2}) rotate(-90)`}>UMAP 2</text></g>
{nodes.map(({t,x,y,r},i)=><g style={`--c:var(--${t.data.colour})`}>
<g class="satellites" aria-hidden="true">{Array.from({length:23},(_,j)=>{const angle=j*2.39996+i*.7;const distance=r+14+(j%4)*9;return <circle cx={x+Math.cos(angle)*distance*1.06} cy={y+Math.sin(angle)*distance*.96} r={3+(j*7+i)%6}/>})}</g>
<a class="map-topic" href={`/research/${t.id}/`} aria-label={t.data.title}><title>{t.data.title}: {t.data.hook}</title><circle cx={x} cy={y} r={r}/>{lines(t.data.shortName).map((line,k,arr)=><text x={x} y={y-(arr.length-1)*11+k*23}>{line}</text>)}<text class="map-open" x={x} y={y+42}>Explore ↗</text></a></g>)}
</svg></div>
<div class="mobile-topics">{topics.map(t=><a href={`/research/${t.id}/`} style={`--c:var(--${t.data.colour})`}>{t.data.shortName}<span aria-hidden="true">↗</span></a>)}</div>
<style>.map-shell{border:1px solid var(--line);border-radius:.5rem;background:#b4c6d233;overflow:hidden;padding:1rem .5rem}.research-map{width:100%;height:auto;display:block}.axes{color:#526c7d}.axes text{fill:currentColor;font:14px var(--f-mono)}.satellites circle{fill:var(--c);opacity:.27}.map-topic circle{fill:color-mix(in srgb,var(--c) 9%,#dce7ee);stroke:var(--c);stroke-width:1.4;transition:fill .2s,stroke-width .2s}.map-topic:hover circle,.map-topic:focus-visible circle{fill:color-mix(in srgb,var(--c) 20%,#e6edf2);stroke-width:3}.map-topic:focus{outline:none}.map-topic:focus-visible circle{stroke-dasharray:5 3}.map-topic text{fill:var(--c);font:600 20px var(--f);text-anchor:middle;pointer-events:none}.map-topic .map-open{font:14px var(--f);fill:var(--ink-2)}.map-caption{font-size:.8rem;color:var(--muted);margin:0 1rem .5rem}.mobile-topics{display:none}@media(max-width:700px){.map-shell{padding:.5rem 0}.mobile-topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:1rem}.mobile-topics a{padding:.9rem;border:1px solid var(--line-2);border-left:3px solid var(--c);text-decoration:none;background:var(--panel);font-size:.9rem;display:flex;align-items:center;justify-content:space-between;gap:.5rem}.map-caption{font-size:.75rem}}</style>
