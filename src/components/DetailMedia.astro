---
const {figures=[],funders=[],funding=[],showFunders=true,showHeading=true}=Astro.props;
const images=figures.filter(f=>f.image?.trim());
const sponsors=funders.filter(f=>f.name?.trim());
const grants=funding.filter(f=>f.trim());
---
{images.length>0&&<section class="detail-section">{showHeading&&<h2>Images and figures</h2>}<div class:list={{'detail-columns':images.length>1}}>{images.map(f=><figure class="detail-figure"><img src={f.image} alt={f.alt||f.caption} loading={showHeading?'lazy':'eager'}/>{(f.caption||f.credit)&&<figcaption>{f.caption}{f.credit&&` · ${f.credit}`}</figcaption>}</figure>)}</div></section>}
{showFunders&&(sponsors.length>0||grants.length>0)&&<section class="detail-section"><h2>Funding</h2>{grants.length>0&&<ul>{grants.map(f=><li>{f}</li>)}</ul>}{sponsors.length>0&&<div class="funder-grid">{sponsors.map(f=><div class="funder">{f.logo&&<img src={f.logo} alt={`${f.name} logo`} loading="lazy"/>}{f.url?<a href={f.url}>{f.name} ↗</a>:<span>{f.name}</span>}</div>)}</div>}</section>}
<style>.image-slot{min-height:220px;justify-content:center;align-items:center;text-align:center}.detail-figure{margin:0}.detail-figure img{width:100%;height:auto;border:1px solid var(--line)}figcaption{font-size:.875rem;color:var(--muted);margin-top:.7rem}.funder-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1rem}.funder{background:var(--panel);padding:1.4rem;display:flex;flex-direction:column;gap:1rem}.funder img{height:80px;max-width:180px;object-fit:contain}</style>
