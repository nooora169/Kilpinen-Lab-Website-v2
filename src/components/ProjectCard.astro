---
const {project,topics=[],publications=[]}=Astro.props;const d=project.data;
const dois=new Set([...d.dois,...topics.filter(t=>d.topics.includes(t.id)).flatMap(t=>t.data.dois)].map(doi=>doi.toLowerCase()));
const leadImage=d.figures?.find(f=>f.image);
const papers=publications.filter(p=>dois.has(p.doi?.toLowerCase())).slice(0,2);
---
<article class="project" style={`--c:var(--${d.colour})`}><span class="eyebrow">{d.status} / Project</span>{leadImage&&<a class="project-image" href={`/projects/${project.id}/`} tabindex="-1" aria-hidden="true"><img src={leadImage.image} alt="" loading="lazy"/></a>}<h3><a href={`/projects/${project.id}/`}>{d.title}</a></h3><p>{d.summary}</p><div class="card-papers">{papers.map(p=><a href={`https://doi.org/${p.doi}`}>{p.journal} · {p.year} ↗</a>)}</div><a class="project-link" href={`/projects/${project.id}/`}>Explore project ↗</a></article>
<style>.project-image{display:block;margin-top:1rem}.project-image img{width:100%;height:160px;object-fit:contain;display:block;background:white;border-radius:4px}.card-papers{display:flex;flex-wrap:wrap;gap:.5rem 1rem;font-size:.8rem;color:var(--muted);margin:1rem 0}.project{padding:2rem;background:var(--panel);border-radius:.5rem;border:1px solid var(--line);border-top:3px solid var(--c);display:flex;flex-direction:column}.project .eyebrow{color:var(--c)}.project h3{font-size:1.6rem;line-height:1.3;letter-spacing:-.03em;margin:1.5rem 0 .5rem}.project h3 a{text-decoration:none}.project h3 a:hover{text-decoration:underline}.project p{color:var(--ink-2)}.project-link{color:var(--c);margin-top:auto;padding-top:1.5rem;font-size:.9rem;text-decoration:none}</style>
