---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import PubList from '../../components/PubList.astro';
import publications from '../../data/publications.json';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('news',({data})=>!data.draft&&data.date<=new Date())).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const d=item.data;
const otherNews=(await getCollection('news',({data})=>!data.draft&&data.date<=new Date())).filter(n=>n.id!==item.id).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()).slice(0,6);
const dateLabel=(date)=>new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(date);
const {Content}=await render(item);
const topics=(await getCollection('topics',({data})=>!data.draft)).filter(t=>d.topics.includes(t.id));
const projects=(await getCollection('projects',({data})=>!data.draft)).filter(p=>d.projects.includes(p.id));
const people=(await getCollection('people')).filter(p=>d.people.includes(p.id));
const papers=publications.filter(p=>d.dois.map(x=>x.toLowerCase()).includes(p.doi.toLowerCase()));
const missing=d.dois.filter(doi=>!papers.some(p=>p.doi.toLowerCase()===doi.toLowerCase()));
---
<Base title={d.title} description={d.summary}><article class="band"><div class="wrap"><a class="back" href="/news/">← All news</a><div class="news-layout"><div class="story"><header class="news-heading"><time datetime={d.date.toISOString().slice(0,10)}>{new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(d.date)}</time><h1 class="disp">{d.title}</h1><p class="intro">{d.summary}</p></header>{d.image&&<figure class="news-figure"><img src={d.image} alt={d.imageAlt||d.title}/>{d.imageCredit&&<figcaption>{d.imageCredit}</figcaption>}</figure>}<div class="prose"><Content/></div>{topics.length>0&&<section class="related"><h2>Related research</h2><div class="links">{topics.map(t=><a class="btn" href={`/research/${t.id}/`}>{t.data.shortName} ↗</a>)}</div></section>}{projects.length>0&&<section class="related"><h2>Related projects</h2><ul>{projects.map(p=><li><a href={`/projects/${p.id}/`}>{p.data.title}</a></li>)}</ul></section>}{people.length>0&&<section class="related"><h2>People</h2><div class="people">{people.map(person=><PersonCard person={person}/>)}</div></section>}{(papers.length>0||missing.length>0)&&<section class="related"><h2>Related publications</h2><PubList publications={papers}/>{missing.map(doi=><p><a href={`https://doi.org/${doi}`}>{doi} ↗</a></p>)}</section>}</div><aside class="news-sidebar" aria-labelledby="other-news-heading"><nav aria-label="Other news"><h2 id="other-news-heading">Other news</h2>{otherNews.length?<ul>{otherNews.map(n=><li><a href={`/news/${n.id}/`}>{n.data.image&&<img src={n.data.image} alt="" loading="lazy" width="80" height="64"/>}<span><time datetime={n.data.date.toISOString().slice(0,10)}>{dateLabel(n.data.date)}</time><strong>{n.data.title}</strong></span></a></li>)}</ul>:<p>More news will appear here.</p>}<a class="archive-link" href="/news/">All news ↗</a></nav></aside></div></div></article></Base>
<style>.news-heading{max-width:60rem;margin:2rem 0}.news-heading time{font:.875rem var(--f-mono);color:var(--muted)}.news-heading h1{margin:1.5rem 0}.news-figure{margin:2rem 0;max-width:900px}.news-figure img{width:100%;height:auto;border-radius:.5rem}.news-figure figcaption{font-size:.875rem;color:var(--muted);margin-top:.7rem}.related{margin-top:3rem}
.news-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:3.5rem;align-items:start}.story{min-width:0}.news-sidebar{margin-top:2rem;padding:1.5rem;background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--cyan);border-radius:.5rem;position:sticky;top:8rem}.news-sidebar h2{font-size:1.3rem;margin:0 0 1rem}.news-sidebar ul{list-style:none;padding:0;margin:0}.news-sidebar li{border-bottom:1px solid var(--line);padding:1rem 0}.news-sidebar li a{display:flex;gap:.8rem;text-decoration:none}.news-sidebar li a:hover strong{text-decoration:underline}.news-sidebar img{width:64px;height:64px;object-fit:cover;border-radius:4px;flex-shrink:0}.news-sidebar time{display:block;font:.7rem var(--f-mono);color:var(--muted);margin-bottom:.5rem}.news-sidebar strong{font-size:.9rem;font-weight:500;line-height:1.4}.news-sidebar p{font-size:.9rem;color:var(--muted)}.archive-link{display:inline-block;margin-top:1.25rem;color:var(--cyan)}.story :global(.prose img){max-width:100%;height:auto;border-radius:.5rem}
@media(max-width:900px){.news-layout{grid-template-columns:1fr;gap:1rem}.news-sidebar{position:static;margin-top:1rem}.news-sidebar li a{align-items:center}}
</style>
