---
import Base from '../layouts/Base.astro';
import HomeSections from '../components/HomeSections.astro';
import NewsList from '../components/NewsList.astro';
import Funders from '../components/Funders.astro';
import site from '../data/site.json';
const headlineParts=site.headline.split(site.headlineHighlight);
---
<Base>
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow">{site.kicker}</p><h1>{headlineParts[0]&&<>{headlineParts[0]}<br/></>}<em>{site.headlineHighlight}</em>{headlineParts.slice(1).join(site.headlineHighlight)}</h1><p class="lede">{site.lede}</p><a class="btn solid" href="/research/">Explore our research ↗</a></div><figure class="hero-image"><div class="hero-microscopy" role="img" aria-label="Original Kilpinen Lab microscopy photograph displayed once inside a decorative neuron silhouette"></div><figcaption><span>From the lab</span><a href="https://www.helsinki.fi/en/researchgroups/cellular-genetics-of-disease">Kilpinen Lab microscopy ↗</a></figcaption></figure></div><div class="wrap hero-bottom"><span>GENETIC VARIATION</span><span>CELLULAR PHENOTYPES</span><span>BRAIN DISORDERS</span></div></section>
<HomeSections sections={['projects']}/>
<div class="band deep"><section class="wrap" id="news"><div class="sec-head"><h2>News</h2><a class="text-link" href="/news/">All news ↗</a></div><NewsList limit={3}/></section></div>
<Funders/>
<section class="home-contact"><div class="wrap"><a class="btn" href="/contact/">Contact the group ↗</a></div></section>
</Base>
<script>
// Keep links to sections of the earlier one-page design usable.
const destinations:Record<string,string>={'#research':'/research/#research','#results':'/publications/#results','#people':'/people/','#publications':'/publications/#publications','#tools':'/resources/','#lablife':'/lab-life/','#contact':'/contact/'};
function followLegacyLink(){const target=destinations[location.hash];if(target)location.replace(target);}
followLegacyLink();window.addEventListener('hashchange',followLegacyLink);
</script>
<style>

.hero{background:#bacdd9;padding:4.5rem 0 0;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.08fr 1fr;gap:3rem;align-items:center}.hero-copy{position:relative;z-index:1}.hero h1{max-width:12ch;font-size:clamp(3rem,5.3vw,5rem);line-height:1.04;letter-spacing:-.06em;margin:1.7rem 0 1.5rem;font-weight:500}.hero h1 em{font-style:normal;color:var(--cyan)}.lede{font-size:1.1rem;max-width:49ch;color:var(--ink-2);margin:0 0 1.8rem;line-height:1.75}.hero-image{margin:0;min-width:0}.hero-image img{display:block;width:100%;height:480px;object-fit:cover;object-position:50% 50%;border-radius:48% 48% 8px 8px;background:#203849}.hero-image figcaption{display:flex;justify-content:space-between;gap:1rem;font-size:.75rem;padding:.75rem 0;color:var(--ink-2)}.hero-image figcaption a{text-decoration:none}.hero-bottom{display:flex;justify-content:space-between;gap:1rem;margin-top:3.5rem;border-top:1px solid #aebfcb;padding-top:1.3rem;padding-bottom:1.3rem;font: .8rem var(--f-mono);letter-spacing:.08em}.section-aside{color:var(--muted);max-width:32ch;margin:0 0 .25rem auto;font-size:1rem}.sec-head .eyebrow{margin:0 0 1.1rem}.sec-head h2{max-width:24ch;line-height:1.12}.text-link{margin-left:auto;color:var(--cyan);text-decoration:none;border-bottom:1px solid var(--line-2);padding-bottom:.25rem}.project-grid,.results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.result{background:var(--panel);border:1px solid var(--line);border-radius:.5rem;overflow:hidden;border-top:3px solid var(--c);display:flex;flex-direction:column}.result-top{display:flex;justify-content:space-between;gap:1rem;font: .75rem var(--f-mono);padding:1.25rem 1.4rem;border-bottom:1px solid var(--line);color:var(--c)}.result-body{padding:1.4rem;display:flex;flex-direction:column;flex:1;gap:1rem}.result h3{font-size:1.4rem;line-height:1.35;margin:0;letter-spacing:-.025em}.result h3 a{text-decoration:none}.result h3 a:hover{text-decoration:underline}.result p{margin:0;color:var(--ink-2)}.result .result-journal{font:.875rem var(--f-mono);color:var(--c)}.result-authors{font-size:.875rem;color:var(--muted)}.result .text-link{margin:1rem auto 0 0}.tool-list{border-top:1px solid var(--line-2)}.tool{display:grid;grid-template-columns:3rem 8rem 1fr 6rem;align-items:center;gap:1.5rem;padding:1.6rem .8rem;border-bottom:1px solid var(--line-2);text-decoration:none;transition:background .2s}.tool:hover{background:#f3f6f899}.tool-code{font:1.3rem var(--f-mono);color:var(--cyan)}.tool h3{font:1.25rem var(--f-mono);margin:0}.tool p{margin:0;color:var(--ink-2)}.tool-repo{font-size:.875rem;color:var(--cyan)}.life-grid{display:grid;grid-template-columns:1fr 1.3fr;align-items:center;gap:5rem}.life-title{font-size:3.4rem;letter-spacing:-.05em;line-height:1.1;margin:1.5rem 0}.gallery figure{margin:0}.gallery img{width:100%;height:auto;border-radius:.5rem;display:block}.gallery figcaption{font-size:.8rem;padding-top:.7rem;color:var(--muted)}.contact-band{background:#24485b;color:#edf6f8;padding:4.5rem 0}.contact-inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.contact-band h2{font-size:2.6rem;letter-spacing:-.04em;line-height:1.2;margin:1rem 0}.contact-band p{color:#d3e3eb}.contact-band .btn{background:#d8edf0;color:#203849;border-color:#d8edf0;white-space:nowrap}
@media(max-width:1000px){.hero-grid{gap:2rem}.hero-image img{height:430px}.project-grid,.results{grid-template-columns:1fr}.result h3{max-width:40ch}.life-grid{gap:2rem}.section-aside{margin-left:0}.tool{grid-template-columns:2rem 6rem 1fr}.tool-repo{grid-column:3}.hero h1{max-width:12ch;font-size:3.5rem}}@media(max-width:650px){.hero{padding-top:2.5rem}.hero-grid,.life-grid{grid-template-columns:1fr}.hero h1{max-width:12ch;font-size:3.1rem}.hero-image img{height:280px;border-radius:8px}.hero-bottom{font-size:.75rem;flex-wrap:wrap;margin-top:2rem;letter-spacing:0}.hero-image figcaption{flex-wrap:wrap}.tool{grid-template-columns:2rem 1fr;gap:1rem}.tool p,.tool-repo{grid-column:2}.contact-inner{align-items:flex-start;flex-direction:column}.life-title{font-size:2.8rem}.contact-band h2{font-size:2.3rem}.text-link{margin-left:0}}

/* The original photo is cropped through a decorative luminance mask.
   The solid copy surface protects text even when editors lengthen it. */
.hero-grid{position:relative;display:block;isolation:isolate;padding-bottom:17rem;min-height:640px}
.hero-copy{width:44%;padding:1rem 1.5rem 2rem 0;background:#bacdd9;box-sizing:border-box}
.hero h1{font-size:clamp(3rem,4.6vw,4.5rem);overflow-wrap:break-word}
.hero-image{position:absolute;inset:0;z-index:-1;display:flex;flex-direction:column}
.hero-microscopy{display:block;width:100%;flex:1;min-height:0;height:100%;background-image:url('/images/microscopy-hero.png');background-size:cover;background-repeat:no-repeat;background-position:50% 50%;-webkit-mask-image:url('/images/neuron-sweep-mask.png');mask-image:url('/images/neuron-sweep-mask.png');mask-mode:luminance;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
.hero-image figcaption{flex:none;justify-content:flex-end;font-size:.875rem;padding-top:1rem}
.hero-bottom{margin-top:1.5rem}
@media(max-width:1000px){
  .hero-grid{display:grid;grid-template-columns:1fr;gap:1rem;padding-bottom:0;min-height:0}
  .hero-copy{width:100%;max-width:44rem;padding:0;background:transparent}
  .hero h1{max-width:16ch;font-size:clamp(2.6rem,6.2vw,3.8rem)}
  .hero-image{position:relative;inset:auto;z-index:auto;display:block}
  .hero-microscopy{height:auto;aspect-ratio:3/2}
  .hero-image figcaption{justify-content:space-between}
}

.home-contact{padding:0 0 4rem;text-align:center}
</style>
