---
import Base from '../../layouts/Base.astro';
import HomeSections from '../../components/HomeSections.astro';
import TopicSection from '../../components/TopicSection.astro';
import { getCollection } from 'astro:content';
const topics = (await getCollection('topics', ({ data }) => !data.draft)).sort((first, second) => first.data.order - second.data.order);
---
<Base title="Research">
  <HomeSections sections={["science"]} pageHeading={true}/>
  <div aria-hidden="true">{['epigenetic-modifiers', 'rare-disease-ipsc', 'crispr-models'].map(id => <span id={id}/>)}</div>
  {topics.map(topic => <TopicSection topic={topic}/>)}
  <HomeSections sections={["projects"]}/>
</Base>

<script>
const previousTopics = ['epigenetic-modifiers', 'rare-disease-ipsc', 'crispr-models'];
function followMergedTopic() {
  if (previousTopics.includes(location.hash.slice(1))) {
    location.replace('#cellular-modelling-ndds');
  }
}
followMergedTopic();
window.addEventListener('hashchange', followMergedTopic);
</script>
