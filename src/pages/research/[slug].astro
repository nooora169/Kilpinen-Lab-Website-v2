---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('topics', ({ data }) => !data.draft))
    .map(topic => ({ params: { slug: topic.id }, props: { topic } }));
}
const { topic } = Astro.props;
---
<LegacyRedirect destination={`/research/#${topic.id}`} title={topic.data.title}/>
