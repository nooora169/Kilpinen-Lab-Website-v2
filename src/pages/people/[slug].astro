---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('people')).map(person => ({ params: { slug: person.id }, props: { person } }));
}
const { person } = Astro.props;
---
<LegacyRedirect destination={`/people/#${person.id}`} title={person.data.name}/>
